    },
    {
      "parameters": {
        "jsCode": "// Si la query devolvió una fila con id, el email ya existe\nconst items = $input.all();\nconst existe = items.some(item => item.json && item.json.id !== null && item.json.id !== undefined);\n\nconst body = $('Webhook Registro').first().json.body || {};\n\nreturn [{\n  json: {\n    email_existe: existe,\n    nombre: body.nombre || 'Usuario',\n    email: body.email,\n    password: body.password\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
