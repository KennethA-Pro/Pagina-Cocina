    {
      "parameters": {
        "jsCode": "const r = $input.first()?.json || {};\nif (r.id) {\n  return [{ json: { ok: true, usuario_id: r.id, nombre: r.nombre, email: r.email, mensaje: 'Usuario registrado correctamente' } }];\n}\nreturn [{ json: { ok: false, mensaje: 'Error al crear el usuario. Intenta de nuevo.' } }];"
      },
