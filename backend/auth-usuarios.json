      "position": [224, 0],
      "credentials": {
        "postgres": {
          "id": "f7EdNg44IQ5OIj14",
          "name": "Postgres account 4"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM usuarios WHERE LOWER(email) = LOWER($1) LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $('Webhook Registro').first().json.body.email }}"
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "verificar-email-existe",
