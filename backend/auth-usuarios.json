      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO usuarios (nombre, email, password)\nVALUES ($1, LOWER($2), crypt($3, gen_salt('bf')))\nRETURNING id, nombre, email;",
        "options": {
          "queryReplacement": "={{ $json.nombre }},={{ $json.email }},={{ $json.password }}"
        }
      },
